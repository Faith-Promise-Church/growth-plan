{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cron/monthly-checkin.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/monthly-checkin",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/monthly-checkin",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
