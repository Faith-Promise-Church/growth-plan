# ---- Browser (these ship to the browser; only the public anon key belongs here) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
# Set to 1 for demo mode (in-memory data, no network). Never set in production.
VITE_DEMO=

# ---- Server only (Vercel functions). Never prefix these with VITE_. ----
SENDGRID_API_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to cron routes.
CRON_SECRET=
# At least 32 random characters. Signs the links in check-in emails.
CHECKIN_TOKEN_SECRET=
CHECKIN_FROM_EMAIL=
CHECKIN_FROM_NAME=Faith Promise Church
CHECKIN_REPLY_TO=
# The public https address of the app, with no trailing slash.
APP_URL=https://growth-plan-sigma.vercel.app
# Set to 1 locally to write rendered emails to docs/emails/ instead of sending.
CHECKIN_DRY_RUN=
